{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "entry": [
    "scripts/**/*.{mjs,cjs,js,ts}",
    ".claude/scripts/**/*.{mjs,cjs,js}",
    ".claude/skills/**/scripts/**/*.{mjs,cjs,js}",
    ".claude/skills/**/scripts-*/**/*.{mjs,cjs,js}",
    "tests/**/*.test.mjs"
  ],
  "project": [
    "src/**/*.{ts,tsx}",
    "scripts/**/*.{mjs,cjs,js,ts}",
    ".claude/**/*.{mjs,cjs,js}",
    "tests/**/*.mjs"
  ],
  "ignore": [
    ".local/**",
    "docs/**",
    ".obsidian/**",
    "public/**",
    "out/**",
    ".claude/config/shadcn-reference/**",
    ".claude/workflows/**"
  ],
  "ignoreBinaries": [
    "cmd.exe",
    "codex",
    "du",
    "ffmpeg",
    "ffprobe",
    "gh",
    "launchctl",
    "magick",
    "netstat",
    "osascript",
    "pdfimages",
    "pdfinfo",
    "pdftoppm",
    "pdftotext",
    "pgrep",
    "pkill",
    "powershell",
    "powershell.exe",
    "ps",
    "python",
    "rclone",
    "sips",
    "swiftc",
    "tesseract",
    "which",
    "yt-dlp"
  ],
  "ignoreDependencies": [
    "@fontsource/noto-sans-jp",
    "hast-util-sanitize",
    "class-variance-authority",
    "@radix-ui/react-slot",
    "@radix-ui/react-dialog",
    "@radix-ui/react-separator",
    "@radix-ui/react-tooltip",
    "@tanstack/react-table",
    "textlint",
    "@fontsource/manrope"
  ]
}
