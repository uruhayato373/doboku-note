{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "entry": [
    "scripts/**/*.{mjs,cjs,js,ts}",
    "tests/**/*.test.mjs"
  ],
  "project": [
    "src/**/*.{ts,tsx}",
    "scripts/**/*.{mjs,cjs,js,ts}",
    ".claude/**/*.{mjs,cjs,js}",
    "tests/**/*.mjs"
  ],
  "ignore": [
    ".claude/config/shadcn-reference/**",
    ".claude/workflows/**"
  ],
  "ignoreBinaries": [
    "ffmpeg",
    "ffprobe",
    "magick",
    "netstat",
    "osascript",
    "pdfimages",
    "pdfinfo",
    "pdftoppm",
    "pdftotext",
    "pgrep",
    "pkill",
    "rclone",
    "sips",
    "swiftc",
    "tesseract",
    "yt-dlp",
    "whisper-cli"
  ],
  "ignoreDependencies": [
    "hast-util-sanitize",
    "@radix-ui/react-slot",
    "@radix-ui/react-dialog",
    "@radix-ui/react-separator",
    "@radix-ui/react-tooltip",
    "@tanstack/react-table",
    "@fontsource/manrope"
  ]
}
