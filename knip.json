{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "entry": [
    "scripts/**/*.{mjs,cjs,js,ts}",
    ".claude/scripts/**/*.{mjs,cjs,js}",
    ".claude/skills/**/scripts/**/*.{mjs,cjs,js}"
  ],
  "project": [
    "src/**/*.{ts,tsx}",
    "scripts/**/*.{mjs,cjs,js,ts}",
    ".claude/**/*.{mjs,cjs,js}"
  ],
  "ignore": [
    ".local/**",
    "docs/**",
    ".obsidian/**",
    "public/**",
    "out/**"
  ],
  "ignoreBinaries": [
    "cmd.exe",
    "du",
    "ffmpeg",
    "ffprobe",
    "gh",
    "launchctl",
    "magick",
    "netstat",
    "osascript",
    "pdfimages",
    "pdfinfo",
    "pdftoppm",
    "pdftotext",
    "pkill",
    "powershell",
    "powershell.exe",
    "ps",
    "python",
    "rclone",
    "sips",
    "tesseract",
    "which"
  ],
  "ignoreDependencies": [
    "hast-util-sanitize"
  ]
}
