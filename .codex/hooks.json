{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node scripts/hooks/agent-hook.mjs check-doc-sync"
          },
          {
            "type": "command",
            "command": "node scripts/hooks/agent-hook.mjs check-gemini-cost"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write",
        "hooks": [
          {
            "type": "command",
            "command": "node scripts/hooks/agent-hook.mjs check-mojibake"
          }
        ]
      },
      {
        "matcher": "Edit",
        "hooks": [
          {
            "type": "command",
            "command": "node scripts/hooks/agent-hook.mjs check-mojibake"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node scripts/hooks/agent-hook.mjs check-stray-files"
          },
          {
            "type": "command",
            "command": "node scripts/hooks/agent-hook.mjs check-disk-hygiene",
            "timeout": 20
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node scripts/hooks/agent-hook.mjs decision-doc-checkpoint"
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node scripts/hooks/agent-hook.mjs decision-doc-checkpoint"
          }
        ]
      }
    ]
  }
}
