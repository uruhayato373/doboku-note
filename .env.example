# .env.example — このリポジトリが読む環境変数の一覧（名前だけ・値は書かない）。
# tests/env-example.test.mjs が scripts/ .claude/ tools/ の process.env.* をここと突合する（新しい変数を足したら 1 行足す）。
#
# 方針（2026-09-14）: 秘密値は GitHub Actions Secrets（CI 限定）に置き、ローカルには置かない。
# 会社 PC はプロキシで外部 API を遮断するため、計測・R2・YouTube はローカルで叩かない（measurement-incidents.md）。
# ローカルで要るのは「ローカル専用の tuning / パス」と「プロキシ」だけ。.env.local は任意で、原則ゼロ秘密値。

# ---- CI 限定（GitHub Actions Secrets。ローカルには置かない）----
GOOGLE_SERVICE_ACCOUNT_KEY_PATH=   # GSC/GA4 service account JSON のパス（CI は Secrets から書き出す）
GA4_PROPERTY_ID=
GOOGLE_API_KEY=                    # Gemini / Google API
GEMINI_API_KEY=                    # Gemini（画像背景生成。課金あり・hook が実行前に確認）
PSI_API_KEY=                       # PageSpeed Insights
CLOUDFLARE_ACCOUNT_ID=             # 公開値（.claude/settings.json / .codex/config.toml にも同じ値）
CLOUDFLARE_R2_ACCESS_KEY_ID=
CLOUDFLARE_R2_SECRET_ACCESS_KEY=
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REFRESH_TOKEN=
YOUTUBE_REPORT_PUBLIC_KEY=
IG_BS_IG_ACCOUNT=                  # Instagram（Buffer/Business Suite 経由の予約投稿）
IG_BS_FB_PAGE=

# ---- ローカル専用（パス・実行環境。秘密値ではない）----
HTTPS_PROXY=                       # 会社 PC のプロキシ（curl / Playwright / AWS SDK が読む）
HTTP_PROXY=
NO_PROXY=
DOBOKU_AUTH_ROOT=                  # Playwright 認証プロファイルの置き場（既定は %LOCALAPPDATA%/doboku-note/playwright-auth）
DOBOKU_PROFILE_ROOT=               # 同上の旧名（互換）
GOOGLE_CONSOLE_SSOT_ROOT=          # GSC/GA4 UI CSV の SSOT ルート（既定 .claude/state/metrics/gsc-ui/ssot）
CHROME_PATH=                       # Playwright に使う Chrome の実行ファイル
FFMPEG_BIN=                        # 動画レンダー（render-longform / Reels）
FFPROBE_BIN=
VOICEVOX_BASE_URL=                 # VOICEVOX エンジン（既定 http://127.0.0.1:50021）
VOICEVOX_SPEAKER=
SITEMAP_ROOT=                      # sitemap の起点 URL を差し替えるとき
REPO_AUDIT_CACHE=                  # audit-repo-assets --history のキャッシュ置き場
LOCAL_MEDIA_PORT=                  # dev の local-media-server（既定 3022）
PORT=                              # static-server（既定 3025）

# ---- チューニング（既定値で足りる。会社 PC の遅い CDN 確定待ちなどで延ばす）----
NOTE_IMG_SETTLE_MIN_MS=
NOTE_IMG_SETTLE_PER_IMG_MS=
NOTE_IMG_UPLOAD_MS=
NOTE_ATTACH_SETTLE_MS=
NOTE_ATTACH_CONFIRM_WAIT_MS=
NOTE_ATTACH_CONFIRM_SETTLE_MS=
NOTE_MIN_HASHTAGS=
PSI_CONCURRENCY=
INSPECT_CONCURRENCY=
TMP_PRUNE_DAYS=
GSC_DEBUG=
VERBOSE=
GIT_DATES_NO_CACHE=
APPLY_DELIVERY=                    # ココナラ納品の実適用フラグ（既定 dry-run）

# ---- pre-commit / 検査の回避フラグ（正当な理由があるときだけ 1）----
SKIP_BACKLOG_SCHEMA=
SKIP_CODEX_COMPAT=
SKIP_DOC_COUPLING=
SKIP_HANDOFF_EXTRACT=
SKIP_INFORMATION_ARCHITECTURE=
SKIP_MAGAZINE_MEMBERSHIP=
SKIP_MEMBERSHIP_DRIP=
SKIP_NOTE_BQ=
SKIP_NOTE_CHARLIMITS=
SKIP_NOTE_PARA=
SKIP_NOTE_UTM=
SKIP_PROJECT_TASK_REFS=
SKIP_RELATIVE_LINKS=
SKIP_SALES_MAPPING=
SKIP_WORKFLOW_HEALTH=
SKIP_X_UTM=

# automation-failure Issue の通知到達（scripts/report-automation-failure.mjs・GitHub Actions 用）
# 起票時の担当者。未設定なら Actions 既定の GITHUB_REPOSITORY_OWNER（repo owner）に assign → GitHub 通知メール
AUTOMATION_ISSUE_ASSIGNEE=
# Slack Incoming Webhook。設定すると起票・再発・復旧を Slack にも送る（未設定なら何もしない）
SLACK_WEBHOOK_URL=
