443,0.05038697,0.18153697,-0.06331547,-0.01621438,-0.06703043,0.02841847,-0.00203859,0.04276324,0.05114577,-0.03234536,-0.00549197,0.11743458,0.01160484,-0.01889623,0.06746927,-0.04123333,0.02905416,-0.00751038,-0.01447962,-0.05624506,0.04873345,-0.04551955,-0.02288792,0.06530682,0.08017192,-0.04674315,-0.00146357,-0.00818207,0.01180697,-0.02159784,0.03460882,-0.0228355,0.04902475,0.00558439,0.02597273,0.06670427,-0.05308732,-0.06674933,0.01661522,0.0180327,0.00765411,0.03871116,0.09677102,0.06560259],"last_embed":{"hash":"ct6oio","tokens":161}}},"last_read":{"hash":"ct6oio","at":1775191733790},"class_name":"SmartSource","last_import":{"mtime":1775191338600,"size":8164,"at":1775191702352,"hash":"ct6oio"},"blocks":{"#---frontmatter---":[1,11],"##必須科目":[13,14],"##問1":[15,65],"##問1#{1}":[17,18],"##問1#背景・文脈":[19,28],"##問1#背景・文脈#{1}":[21,28],"##問1#設問":[29,65],"##問1#設問#(1) 本論文においてあなたが取り上げる事業や組織の内容と、そこにおけるこれまでのCNに関連する取組状況について、以下の問いに答えよ。":[31,43],"##問1#設問#(1) 本論文においてあなたが取り上げる事業や組織の内容と、そこにおけるこれまでのCNに関連する取組状況について、以下の問いに答えよ。#{1}":[33,38],"##問1#設問#(1) 本論文においてあなたが取り上げる事業や組織の内容と、そこにおけるこれまでのCNに関連する取組状況について、以下の問いに答えよ。#{2}":[39,39],"##問1#設問#(1) 本論文においてあなたが取り上げる事業や組織の内容と、そこにおけるこれまでのCNに関連する取組状況について、以下の問いに答えよ。#{3}":[40,41],"##問1#設問#(1) 本論文においてあなたが取り上げる事業や組織の内容と、そこにおけるこれまでのCNに関連する取組状況について、以下の問いに答えよ。#{4}":[42,43],"##問1#設問#(2) この事業や組織において、温室効果ガスの抑制策として近い将来（およおよね5年以内）に導入が可能で効果が高いと考えられる施策を2つ取り上げ、それぞれについて、以下の問いに答えよ。なお、想定する時期までに事業や組織の内容や形態そのものが変化することを踏まえて解答してもかまわない。":[44,53],"##問1#設問#(2) この事業や組織において、温室効果ガスの抑制策として近い将来（およおよね5年以内）に導入が可能で効果が高いと考えられる施策を2つ取り上げ、それぞれについて、以下の問いに答えよ。なお、想定する時期までに事業や組織の内容や形態そのものが変化することを踏まえて解答してもかまわない。#{1}":[46,53],"##問1#設問#(3) 今後の技術革新の進展を見据え、我が国において2050年時点でのCN実現に向けて、あなたが重要と考える施策を2つ取り上げ、それぞれについて以下の問いに答えよ。なお、問い（3）では、事業や組織の種を超え、我が国として取るべき施策について解答すること。":[54,65],"##問1#設問#(3) 今後の技術革新の進展を見据え、我が国において2050年時点でのCN実現に向けて、あなたが重要と考える施策を2つ取り上げ、それぞれについて以下の問いに答えよ。なお、問い（3）では、事業や組織の種を超え、我が国として取るべき施策について解答すること。#{1}":[56,65],"##2050年長期戦略における成長が期待される14の重要産業分野":[66,79],"##2050年長期戦略における成長が期待される14の重要産業分野#【エネルギー関連産業】":[68,71],"##2050年長期戦略における成長が期待される14の重要産業分野#【エネルギー関連産業】#{1}":[70,71],"##2050年長期戦略における成長が期待される14の重要産業分野#【輸送・製造関連産業】":[72,75],"##2050年長期戦略における成長が期待される14の重要産業分野#【輸送・製造関連産業】#{1}":[74,75],"##2050年長期戦略における成長が期待される14の重要産業分野#【家庭・オフィス関連産業】":[76,79],"##2050年長期戦略における成長が期待される14の重要産業分野#【家庭・オフィス関連産業】#{1}":[78,79]},"outlinks":[{"title":"attachments/R06_記述式.pdf","target":"attachments/R06_記述式.pdf","line":10}],"metadata":{"title":"技術士二次試験 総合技術監理部門 令和6年度 記述式","type":"技術基準","category":"技術士","tags":["#技士（総合技術監理部門）","#記述式","#令和6年度"],"created":"2026-04-02","source_pdf":"[[attachments/R06_記述式.pdf]]"},"task_lines":[],"tasks":{},"codeblock_ranges":[],"last_embed":{"hash":"ct6oio","at":1775191733452}},"smart_blocks:drafts/writing/R06_記述式.md##問1": {"path":null,"embeddings":{"TaylorAI/bge-micro-v2":{"vec":[-0.04887336,0.01305341,0.00326929,-0.01852041,-0.02399642,0.03437974,-0.00931637,0.07242256,0.07152352,0.02443731,-0.02118793,-0.04078946,0.02371095,0.04830283,0.00068991,0.00098564,-0.04735333,-0.01092889,-0.05028337,-0.00078988,0.13964151,-0.02866109,0.00051228,-0.04306765,0.07402357,0.05167163,-0.02014369,0.00062718,-0.01861026,-0.16171704,-0.06379436,0.03929153,0.0585317,-0.0191243,0.04833338,0.06591034,-0.0399517,0.05665711,-0.02653236,-0.0047823,0.00874758,0.01080532,0.02272077,0.01142851,0.00160909,-0.02506544,-0.01675595,-0.05491342,0.06013635,0.00450216,-0.07080336,-0.04244933,0.01802864,0.00912849,0.05139947,-0.01678163,0.0584654,0.01429952,0.03750379,-0.02264208,0.01514955,0.03408269,-0.2085209,0.05971526,0.01425452,-0.01164582,-0.09713008,0.00414984,0.03433762,0.05644844,-0.00418785,-0.01655958,-0.00289362,0.08138134,0.00859373,-0.03100003,-0.04619139,-0.03528605,0.02357121,-0.02521872,-0.03690766,0.07267257,-0.01041421,0.00195477,-0.01307621,0.02605062,-0.00143199,-0.04563648,0.01745415,0.04085423,-0.01065218,-0.03300609,0.06362896,0.09197119,-0.08443247,0.01404806,0.03550752,-0.03370041,-0.01884616,0.13457932,-0.04730406,-0.01187747,0.00295787,0.00261574,-0.