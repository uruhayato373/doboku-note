.0519459,0.195024,-0.02368186,0.0291367,-0.05256856,-0.00048759,0.02016714,0.02596299,0.05462275,-0.00642601,-0.03083662,0.10635089,0.03179041,0.00742848,0.09338545,-0.03393961,0.01227685,0.02165096,0.01398786,-0.04424769,0.02577719,-0.06743792,-0.02982352,0.07441705,0.07190364,-0.05927039,0.00517851,-0.0339317,0.02324219,-0.02866396,0.03742892,-0.04198334,0.06323344,-0.01822809,0.070736,0.02411747,-0.04867261,-0.04609497,0.00465946,0.01185315,0.03902547,0.04274753,0.11464275,0.09835716],"last_embed":{"hash":"g5z8fl","tokens":152}}},"last_read":{"hash":"g5z8fl","at":1775191726003},"class_name":"SmartSource","last_import":{"mtime":1775191338523,"size":6903,"at":1775191702352,"hash":"g5z8fl"},"blocks":{"#---frontmatter---":[1,11],"#令和4年度技術士第二次試験問題【総合技術監理部門】":[13,66],"#令和4年度技術士第二次試験問題【総合技術監理部門】#必須科目":[15,16],"#令和4年度技術士第二次試験問題【総合技術監理部門】#問1":[17,66],"#令和4年度技術士第二次試験問題【総合技術監理部門】#問1#問題文":[19,30],"#令和4年度技術士第二次試験問題【総合技術監理部門】#問1#問題文#{1}":[21,30],"#令和4年度技術士第二次試験問題【総合技術監理部門】#問1#設問":[31,66],"#令和4年度技術士第二次試験問題【総合技術監理部門】#問1#設問#(1) 本論文においてあなたが取り上げる事業や組織の内容と、そこにおける過去から現在までのデジタル技術の利用状況について、以下の問いに答えよ。":[33,46],"#令和4年度技術士第二次試験問題【総合技術監理部門】#問1#設問#(1) 本論文においてあなたが取り上げる事業や組織の内容と、そこにおける過去から現在までのデジタル技術の利用状況について、以下の問いに答えよ。#{1}":[35,42],"#令和4年度技術士第二次試験問題【総合技術監理部門】#問1#設問#(1) 本論文においてあなたが取り上げる事業や組織の内容と、そこにおける過去から現在までのデジタル技術の利用状況について、以下の問いに答えよ。#{2}":[43,43],"#令和4年度技術士第二次試験問題【総合技術監理部門】#問1#設問#(1) 本論文においてあなたが取り上げる事業や組織の内容と、そこにおける過去から現在までのデジタル技術の利用状況について、以下の問いに答えよ。#{3}":[44,44],"#令和4年度技術士第二次試験問題【総合技術監理部門】#問1#設問#(1) 本論文においてあなたが取り上げる事業や組織の内容と、そこにおける過去から現在までのデジタル技術の利用状況について、以下の問いに答えよ。#{4}":[45,46],"#令和4年度技術士第二次試験問題【総合技術監理部門】#問1#設問#(2) DXを単なるデジタル技術の利用ではなく、デジタル技術を活用したビジネスやプロセスの変革と捉えた場合、(1)で取り上げた事業や組織において、DXとして既に実施している取組、若しくは直近に始まろうとしている取組みについて、以下の問いに答えよ。":[47,54],"#令和4年度技術士第二次試験問題【総合技術監理部門】#問1#設問#(2) DXを単なるデジタル技術の利用ではなく、デジタル技術を活用したビジネスやプロセスの変革と捉えた場合、(1)で取り上げた事業や組織において、DXとして既に実施している取組、若しくは直近に始まろうとしている取組みについて、以下の問いに答えよ。#{1}":[49,54],"#令和4年度技術士第二次試験問題【総合技術監理部門】#問1#設問#(3) (1)で取り上げた事業や組織におけるDX推進の端緒とするため、求年度からスタートする5ヶ年のDX推進計画を策定するタスクフォースが設置され、あなたはそのリーダーに指名された。タスクフォースの使用は13週（約3ヶ月）でDX推進計画を策定することであり、その計画には、「実現目標」、「取組内容」、「推進体制」、「予算」などの項目が盛り込まれることになる。このDX推進計画及びタスクフォースに関して、以下の問いに答えよ。":[55,66],"#令和4年度技術士第二次試験問題【総合技術監理部門】#問1#設問#(3) (1)で取り上げた事業や組織におけるDX推進の端緒とするため、求年度からスタートする5ヶ年のDX推進計画を策定するタスクフォースが設置され、あなたはそのリーダーに指名された。タスクフォースの使用は13週（約3ヶ月）でDX推進計画を策定することであり、その計画には、「実現目標」、「取組内容」、「推進体制」、「予算」などの項目が盛り込まれることになる。このDX推進計画及びタスクフォースに関して、以下の問いに答えよ。#{1}":[57,66]},"outlinks":[{"title":"attachments/R04_記述式.pdf","target":"attachments/R04_記述式.pdf","line":10}],"metadata":{"title":"技術士二次試験 総合技術監理部門 令和4年度 記述式","type":"技術基準","category":"技術士","tags":["#技士（総合技術監理部門）","#記述式","#令和4年度"],"created":"2026-04-02","source_pdf":"[[attachments/R04_記述式.pdf]]"},"task_lines":[],"tasks":{},"codeblock_ranges":[],"last_embed":{"hash":"g5z8fl","at":1775191725549}},"smart_blocks:drafts/writing/R04_記述式.md#令和4年度技術士第二次試験問題【総合技術監理部門】": {"path":null,"embeddings":{"TaylorAI/bge-micro-v2":{"vec":[-0.05421008,0.01347605,-0.02997412,0.00294234,-0.0038732,0.04021231,-0.03666706,0.06782787,0.06182376,-0.00176843,-0.035191,-0.0481323,0.08333364,0.02870458,0.01109954,-0.00797232,-0.0442649,-0.03189327,-0.03136934,0.03620777,0.11892235,-0.03253367,0.01594951,-0.0608794,0.08428025,0.03319002,-0.01264002,-0.02824334,-0.04343087,-0.17528911,-0.04182756,0.0597285,0.04939185,-0.00217883,0.02739858,0.06647628,-0.04607766,0.0607641,-0.02253819,-0.0010213,-0.01399265,0.03228548,0.00590087,0.00035331,-0.01456119,-0.01798531,-0.06982443,-0.02769277,0.04236114,-0.00423712,-0.05192401,-0.01970861,0.02575105,0.02217645,0.02379602,0.00123278,0.05233587,0.00340652,0.0214764,-0.02017246,0.02880536,0.0873366,-0.22816567,0.04638918,0.00730237,-0.00632482,-0.11962724,-0.01167262,0.06609371,0.02185667,-0.0386312,-0.00868042,-0.0202883,0.04039958,-0.02517901,0.01594711,-0.00927336,-0.04926157,0.00606811,0.00633545,-0.0577204,0.08871812,-0.00983154,-0.00165344,-0.02769249,0.06388161,0.00972679,-0.07701216,0.01371199,0.05402849,-0.01253649,-0.0075517,0.05713345