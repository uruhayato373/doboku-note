{
  "ci": {
    "collect": {
      "startServerCommand": "npm run serve",
      "startServerReadyPattern": "http://localhost:3025",
      "startServerReadyTimeout": 30000,
      "url": [
        "http://localhost:3025/",
        "http://localhost:3025/exam/pe-comprehensive-management/keywords/alarp-principle",
        "http://localhost:3025/exam/civil-construction-1/secondary/r06",
        "http://localhost:3025/tools/keiken-charcount"
      ],
      "numberOfRuns": 3,
      "settings": {
        "chromeFlags": "--no-sandbox --headless"
      }
    },
    "assert": {
      "assertions": {
        "categories:accessibility": ["error", { "minScore": 0.95 }],
        "categories:seo": ["error", { "minScore": 0.95 }],
        "categories:best-practices": ["error", { "minScore": 0.9 }],
        "categories:performance": ["warn", { "minScore": 0.7 }]
      }
    },
    "upload": {
      "target": "filesystem",
      "outputDir": ".lighthouseci"
    }
  }
}
