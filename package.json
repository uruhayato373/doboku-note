{
  "name": "doboku-note",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "download-images": "node scripts/download-images-from-r2.mjs",
    "sync-images": "node scripts/sync-content-images.mjs",
    "dev": "node scripts/sync-content-images.mjs && node scripts/serve-local-r2.mjs & next dev -p 3020",
    "build": "node scripts/generate-search-index.mjs && next build && node scripts/generate-sitemap.mjs",
    "start": "node scripts/sync-content-images.mjs && node scripts/serve-local-r2.mjs & next start -p 3020",
    "lint": "next lint",
    "pages:deploy": "npx wrangler pages deploy out --project-name=doboku-note"
  },
  "dependencies": {
    "clsx": "^2",
    "gray-matter": "^4",
    "katex": "^0.16",
    "mermaid": "^10",
    "next": "^16.1.7",
    "next-mdx-remote": "^5",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-icons": "^5",
    "rehype-katex": "^7",
    "remark-directive": "^3",
    "remark-gfm": "^4",
    "remark-math": "^6",
    "unist-util-visit": "^5"
  },
  "devDependencies": {
    "@aws-sdk/client-s3": "^3.1016.0",
    "@types/node": "^20",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "autoprefixer": "^10",
    "postcss": "^8",
    "tailwindcss": "^3",
    "typescript": "^5"
  },
  "engines": {
    "node": ">=18.0"
  }
}
