{
  "name": "doboku-note",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "predev": "node scripts/kill-port.mjs 3020 && node scripts/build-exam-backlinks.mjs",
    "dev": "next dev -p 3020",
    "build-backlinks": "node scripts/build-exam-backlinks.mjs",
    "build": "rm -rf out && node scripts/build-exam-backlinks.mjs && node scripts/generate-search-index.mjs && next build && node scripts/generate-sitemap.mjs",
    "generate-ogp": "node scripts/generate-ogps.mjs",
    "start": "next start -p 3020",
    "lint": "eslint src/",
    "type-check": "tsc --noEmit",
    "pages:deploy": "npx wrangler pages deploy out --project-name=doboku-note",
    "upload-images-r2": "tsx scripts/upload-images-to-r2.mjs",
    "diff-r2": "node scripts/diff-r2.mjs",
    "fetch-gsc-data": "node scripts/fetch-gsc-data.mjs",
    "validate-mdx": "node scripts/validate-mdx.mjs",
    "pre-commit:install": "node scripts/install-pre-commit.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.908.0",
    "@aws-sdk/lib-storage": "^3.908.0",
    "@mdx-js/loader": "^3.1.0",
    "@mdx-js/react": "^3.1.0",
    "@next/mdx": "^16.0.0",
    "@tailwindcss/typography": "^0.5.16",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "dotenv": "^17.2.3",
    "googleapis": "^171.4.0",
    "gray-matter": "^4.0.3",
    "katex": "^0.16",
    "lucide-react": "^0.542.0",
    "mermaid": "^10",
    "minisearch": "^7.2.0",
    "next": "^16.0.0",
    "next-mdx-remote": "^6.0.0",
    "next-themes": "^0.4.6",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-icons": "^5",
    "react-is": "^19.2.4",
    "recharts": "^3.1.2",
    "rehype-external-links": "^3.0.0",
    "rehype-katex": "^7",
    "remark": "^15.0.1",
    "remark-directive": "^3",
    "remark-gfm": "^4",
    "remark-html": "^16.0.1",
    "remark-math": "^6",
    "sharp": "^0.34.3",
    "swr": "^2.3.6",
    "tailwind-merge": "^3.3.1",
    "unist-util-visit": "^5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.48.2",
    "@resvg/resvg-js": "^2.6.2",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "autoprefixer": "^10.4.21",
    "eslint": "^9.0.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "postcss": "^8.5.6",
    "satori": "^0.26.0",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.20.5",
    "typescript": "^5",
    "typescript-eslint": "^8.58.0"
  },
  "engines": {
    "node": ">=18.0"
  }
}
