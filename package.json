{
  "name": "doboku-note",
  "version": "1.0.0",
  "private": true,
  "imports": {
    "#lib/*": "./.claude/scripts/lib/*",
    "#shared/*": "./.claude/scripts/*"
  },
  "scripts": {
    "predev": "node scripts/kill-port.mjs 3020",
    "dev": "next dev -p 3020",
    "build-backlinks": "node .claude/skills/quality/exam-backlinks/scripts/build-exam-backlinks.mjs",
    "build-indexes": "node .claude/scripts/build-doc-meta-index.mjs && node .claude/scripts/build-cross-exam-keyword-index.mjs && node .claude/scripts/build-tag-index.mjs",
    "build-keyword-relations": "node .claude/skills/quality/exam-backlinks/scripts/build-keyword-relations.mjs",
    "build-pillar-exam-questions": "node .claude/scripts/build-pillar-exam-questions.mjs",
    "insert-keyword-relations": "node .claude/skills/quality/exam-backlinks/scripts/insert-keyword-relations.mjs",
    "refresh-indexes": "npm run build-backlinks && npm run build-indexes && npm run build-keyword-relations && npm run build-pillar-exam-questions",
    "sales-summary": "node scripts/sales-summary.mjs",
    "verify-note-magazines": "node scripts/verify-note-magazines.mjs",
    "note-edit-session": "node scripts/note-edit-session.mjs",
    "note-edit-magazine": "node scripts/note-edit-magazine.mjs",
    "note-meta-lint": "node scripts/note-meta-lint.mjs",
    "note-meta-to-txt": "node scripts/note-meta-to-txt.mjs",
    "note-lint": "node scripts/note-lint.mjs",
    "note-reflow": "node scripts/reflow-note-paragraphs.mjs",
    "note-inject-magazine-url": "node .claude/scripts/note/inject-magazine-url.cjs",
    "x-sync-status": "node scripts/x-sync-status.mjs",
    "x-schedule-view": "node scripts/x-schedule-view.mjs",
    "generate-webp": "node .claude/scripts/generate-webp.mjs",
    "update-image-refs": "node .claude/scripts/update-mdx-image-refs.mjs",
    "prebuild": "npm run generate-webp && npm run update-image-refs",
    "build": "rm -rf out && npm run refresh-indexes && next build && npx pagefind --site out --output-path out/pagefind && cp -r out/pagefind public/pagefind && node scripts/generate-sitemap.mjs && node scripts/generate-rss.mjs",
    "ogp": "node .claude/skills/conversion/ogp-create/scripts/ogp-create.mjs",
    "start": "next start -p 3020",
    "lint": "eslint src/",
    "type-check": "tsc --noEmit",
    "pages:deploy": "npx wrangler pages deploy out --project-name=doboku-note",
    "upload-images-r2": "tsx .claude/scripts/upload-images-to-r2.mjs",
    "diff-r2": "node .claude/skills/dev/diff-r2/scripts/diff-r2.mjs",
    "fetch-gsc-data": "node .claude/skills/analytics/fetch-gsc-data/scripts/fetch-gsc-data.mjs",
    "fetch-ga4-data": "node .claude/scripts/fetch-ga4-data.mjs",
    "fetch-ga4-cta-clicks": "node .claude/scripts/fetch-ga4-cta-clicks.mjs",
    "report-monetization-coverage": "tsx .claude/scripts/report-monetization-coverage.mts",
    "audit-ga4-bot-ratio": "node .claude/scripts/audit-ga4-bot-ratio.mjs",
    "fetch-psi-data": "node .claude/scripts/fetch-psi-data.mjs",
    "fetch-psi-audit": "node .claude/scripts/fetch-psi-data.mjs --file .claude/config/psi-urls.txt --strategy mobile && node .claude/scripts/fetch-psi-data.mjs --file .claude/config/psi-urls.txt --strategy desktop",
    "psi-audit:check": "node .claude/scripts/psi-threshold-check.mjs",
    "check-seo-meta": "node .claude/skills/quality/check-seo-meta/scripts/check-seo-meta.mjs",
    "check-seo-meta:check": "node .claude/skills/quality/check-seo-meta/scripts/seo-meta-threshold-check.mjs",
    "check-doc-refs": "node scripts/check-doc-refs.mjs",
    "check-doc-coupling": "node scripts/check-doc-coupling.mjs --staged",
    "check-links": "node .claude/skills/quality/check-mdx/scripts/rules/links/check-links.mjs",
    "check-links-audit": "node .claude/skills/quality/check-mdx/scripts/rules/links/check-links.mjs --scope all --report .claude/state/link-audit/",
    "inspect-url": "node .claude/scripts/inspect-url.mjs",
    "validate-mdx": "node .claude/scripts/validate-mdx.mjs",
    "pre-commit:install": "node scripts/install-pre-commit.mjs",
    "pre-push:install": "node scripts/install-pre-push.mjs",
    "test": "node --test tests/",
    "test:watch": "node --test --watch tests/"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.908.0",
    "@aws-sdk/lib-storage": "^3.908.0",
    "@fontsource/manrope": "^5.2.8",
    "@fontsource/noto-sans-jp": "^5.2.9",
    "@google-analytics/data": "^5.2.1",
    "@mdx-js/loader": "^3.1.0",
    "@mdx-js/react": "^3.1.0",
    "@next/mdx": "^16.0.0",
    "@tailwindcss/typography": "^0.5.16",
    "budoux": "^0.8.2",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "dotenv": "^17.2.3",
    "googleapis": "^171.4.0",
    "gray-matter": "^4.0.3",
    "katex": "^0.16",
    "lucide-react": "^0.542.0",
    "mermaid": "^10",
    "next": "^16.0.0",
    "next-mdx-remote": "^6.0.0",
    "next-themes": "^0.4.6",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-icons": "^5",
    "react-is": "^19.2.4",
    "recharts": "^3.1.2",
    "rehype-external-links": "^3.0.0",
    "rehype-katex": "^7",
    "remark": "^15.0.1",
    "remark-directive": "^3",
    "remark-gfm": "^4",
    "remark-html": "^16.0.1",
    "remark-math": "^6",
    "sharp": "^0.34.3",
    "swr": "^2.3.6",
    "tailwind-merge": "^3.3.1",
    "unist-util-visit": "^5",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.48.2",
    "@resvg/resvg-js": "^2.6.2",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "autoprefixer": "^10.4.21",
    "eslint": "^9.0.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "pagefind": "^1.5.2",
    "postcss": "^8.5.6",
    "satori": "^0.26.0",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.20.5",
    "typescript": "^5",
    "typescript-eslint": "^8.58.0"
  },
  "engines": {
    "node": ">=18.0"
  }
}
