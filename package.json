{
  "name": "doboku-note",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "node scripts/sync-content-images.mjs && node scripts/serve-local-r2.mjs & next dev -p 3020",
    "build": "node scripts/generate-search-index.mjs && next build && node scripts/generate-sitemap.mjs",
    "start": "next start -p 3020",
    "lint": "next lint",
    "type-check": "tsc --noEmit",
    "pages:deploy": "npx wrangler pages deploy out --project-name=doboku-note",
    "sitemap": "next-sitemap",
    "upload-images-r2": "tsx scripts/upload-images-to-r2.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.908.0",
    "@aws-sdk/lib-storage": "^3.908.0",
    "@mdx-js/loader": "^3.1.0",
    "@mdx-js/react": "^3.1.0",
    "@next/mdx": "^14.2.33",
    "@tailwindcss/typography": "^0.5.16",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "dotenv": "^17.2.3",
    "gray-matter": "^4.0.3",
    "katex": "^0.16",
    "lucide-react": "^0.542.0",
    "mermaid": "^10",
    "minisearch": "^7.2.0",
    "next": "^14.0.0",
    "next-mdx-remote": "^5.0.0",
    "next-sitemap": "^4.2.3",
    "next-themes": "^0.4.6",
    "react": "^18.0.0",
    "react-dom": "^18.0.0",
    "react-icons": "^5",
    "recharts": "^3.1.2",
    "rehype-katex": "^7",
    "remark": "^15.0.1",
    "remark-directive": "^3",
    "remark-gfm": "^4",
    "remark-html": "^16.0.1",
    "remark-math": "^6",
    "sharp": "^0.34.3",
    "swr": "^2.3.6",
    "tailwind-merge": "^3.3.1",
    "unist-util-visit": "^5"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "autoprefixer": "^10.4.21",
    "eslint": "^8.0.0",
    "eslint-config-next": "^14.0.0",
    "postcss": "^8.5.6",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.20.5",
    "typescript": "^5"
  },
  "engines": {
    "node": ">=18.0"
  }
}
