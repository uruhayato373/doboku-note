{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "dev",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev"
      ],
      "port": 3020
    },
    {
      "name": "admin",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "admin"
      ],
      "port": 3021,
      "url": "http://127.0.0.1:3021"
    },
    {
      "name": "serve",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "serve"
      ],
      "port": 3025
    },
    {
      "name": "x-outreach",
      "runtimeExecutable": "python3",
      "runtimeArgs": [
        "-m",
        "http.server",
        "3026",
        "--bind",
        "127.0.0.1",
        "--directory",
        ".tmp/x-outreach"
      ],
      "port": 3026
    }
  ]
}
