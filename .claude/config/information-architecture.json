      "data/metrics"
    ]
  },
  "docsIsNotContent": {
    "_doc": "docs/ は人が読む恒久判断の置き場。制作物（記事本文・投稿素材・状態 JSON・バイナリ）が入り込んだら content/ へ出す。",
    "denyBasenames": [
      "article.md",
      "article.mdx",
      "slide-data.json",
      "posted.json",
      "caption.txt",
      "_meta.yaml"
    ],
    "denyExtensions": [
      ".mdx",
      ".mp4",
      ".wav",
      ".epub",
      ".pdf"
    ],
    "allowDirs": [
      "docs/design/images",
      "docs/handoffs",
      "docs/reviews"
    ]
  },
  "contentIsNotFlow": {
    "_doc": "content/ は顧客へ届ける制作物とその入力。実装計画・TODO 台帳・進捗ログは flow なので .claude/ か docs/ へ置く。",
    "denyBasenames": [
      "backlog.md",
      "weekly.md",
      "monthly.md",
      "annual.md",
      "TODO.md"
    ],
    "denyPatterns": [
      "^content/[^/]+/plans?/",
      "^content/[^/]+/todo/",
      "^content/sns/schedule\\.json$"
    ]
  },
  "dualSsot": {
    "_doc": "旧ルートと新ルートに同じ相対パスが同時に存在する状態。移行が途中で止まった形。",
    "pairs": []
  },
  "allowlist": {
    "_doc": "個別に許す実パス。理由を必ず書く。空にできるのが理想。",
    "entries": []
  },
  "stalePathLiterals": {
