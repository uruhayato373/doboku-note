{
  "env": {
    "CLOUDFLARE_ACCOUNT_ID": "cc10e4d021f2b259238dc98dfeebe907"
  },
  "permissions": {
    "deny": [
      "Bash(git reset --hard:*)",
      "Bash(git clean:*)",
      "Bash(rm -rf /:*)",
      "Bash(rm -rf ~:*)"
    ],
    "allow": [
      "Bash(curl:*)",
      "Bash(pdftoppm:*)",
      "Bash(magick:*)",
      "Bash(cp:*)",
      "Bash(mkdir:*)",
      "Bash(ls:*)",
      "Bash(wc:*)",
      "Bash(npm run build:*)",
      "Bash(cat:*)",
      "Bash(npm:*)",
      "Bash(npx:*)",
      "Bash(git:*)",
      "Bash(mv:*)",
      "Bash(rm:*)",
      "Bash(find:*)",
      "Bash(grep:*)",
      "Bash(sort:*)",
      "Bash(head:*)",
      "Bash(tail:*)",
      "Bash(echo:*)",
      "Bash(which:*)",
      "Bash(node:*)",
      "Bash(python:*)",
      "Bash(python3:*)",
      "Bash(shuf:*)",
      "Bash(for:*)",
      "Read",
      "Edit",
      "Write",
      "Glob",
      "Grep",
      "WebFetch",
      "WebSearch",
      "Agent",
      "Skill",
      "Bash(gh run:*)",
      "Bash(gh auth:*)",
      "Bash(gh pr:*)",
      "Bash(gh api:*)",
      "Bash(git show:*)",
      "mcp__playwright__browser_resize",
      "mcp__playwright__browser_navigate",
      "mcp__playwright__browser_take_screenshot",
      "mcp__playwright__browser_evaluate",
      "mcp__playwright__browser_snapshot",
      "mcp__playwright__browser_click",
      "mcp__playwright__browser_close",
      "mcp__playwright__browser_tabs",
      "mcp__visualize__read_me",
      "mcp__visualize__show_widget",
      "mcp__Claude_in_Chrome__list_connected_browsers",
      "mcp__Claude_in_Chrome__navigate",
      "mcp__Claude_in_Chrome__tabs_context_mcp",
      "mcp__mcp-registry__search_mcp_registry",
      "mcp__mcp-registry__list_connectors"
    ],
    "ask": [
      "Bash(npm run ogp-backgrounds:*)",
      "Bash(node scripts/generate-ogp-backgrounds.mjs:*)",
      "Bash(gemini:*)"
    ],
    "defaultMode": "bypassPermissions"
  },
  "enabledMcpjsonServers": [
    "aidesigner"
  ],
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node scripts/session-start.mjs 2>/dev/null || true",
            "timeout": 120,
            "statusMessage": "同期・台帳・容量を確認中...",
            "async": true
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node scripts/hooks/agent-hook.mjs check-doc-sync"
          },
          {
            "type": "command",
            "command": "node scripts/hooks/agent-hook.mjs check-gemini-cost"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write",
        "hooks": [
          {
            "type": "command",
            "command": "node scripts/hooks/agent-hook.mjs check-mojibake"
          }
        ]
      },
      {
        "matcher": "Edit",
        "hooks": [
          {
            "type": "command",
            "command": "node scripts/hooks/agent-hook.mjs check-mojibake"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node scripts/hooks/agent-hook.mjs check-stray-files"
          },
          {
            "type": "command",
            "command": "node scripts/hooks/agent-hook.mjs check-disk-hygiene",
            "timeout": 20
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node scripts/hooks/agent-hook.mjs decision-doc-checkpoint"
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node scripts/hooks/agent-hook.mjs decision-doc-checkpoint"
          }
        ]
      }
    ]
  }
}
