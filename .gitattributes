# GSC/GA4 CSV パーサのテスト fixture は「バイト厳密」（BOM/CRLF/quoted-newline）が本質。
# EOL 正規化されると CRLF テストが壊れるため -text（EOL 変換禁止）＋ -whitespace（空白検査除外）。
tests/fixtures/google-console/*.csv -text -whitespace

# 公的資料の逐語文字起こしは紙面の空白・行末空白も検証対象として保持する。
# 通常の Markdown 編集規則で削ると原本対応が崩れるため、この生成ライブラリだけ whitespace 検査を外す。
content/site/standards-library/**/*.md -whitespace

# 商品の正本（DN-0492）: Windows / Mac で改行をそろえる（product CLI は LF で書く）
content/products/**/*.json text eol=lf

# public/_redirects は生成スクリプトが LF で書く。autocrlf の PC で改行差だけの変更が毎回出るのを防ぐ
public/_redirects text eol=lf

# 追記だけの台帳（data/**/*.jsonl・rank-watch など）は 1 行 1 件。PC ごとに改行が変わると「既存の行を変えていない」の検査が崩れる
data/**/*.jsonl text eol=lf

# 設定・記録の JSON（台帳 scripts/lib/datasets.mjs の config/・data/）は LF にそろえる。書き込みは scripts/lib/json-io.mjs の formatJson（字下げ 2・LF・末尾改行）。
# PC ごとに改行が変わると、中身が同じなのに差分が出て「同じ中身なら書かない」も効かなくなる
config/**/*.json text eol=lf
data/**/*.json text eol=lf
