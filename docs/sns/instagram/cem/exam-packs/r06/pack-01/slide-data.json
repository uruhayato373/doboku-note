      "optionExplanations": [
        {
          "num": 1,
          "correct": false,
          "text": "133万円では増分収益の現在価値が追加投資の現在価値を下回る。"
        },
        {
          "num": 2,
          "correct": false,
          "text": "140万円では増分収益の現在価値がやや不足する。"
        },
        {
          "num": 3,
          "correct": true,
          "text": "400/1.05^2 = x×(1/1.05^3+1/1.05^4+1/1.05^5)を解くとx≒147万円。"
        },
        {
          "num": 4,
