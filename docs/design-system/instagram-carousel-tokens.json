{
  "_meta": {
    "purpose": "Instagram カルーセル（_exam-packs）の真実源デザイントークン。AIDesigner プロトタイプ準拠。",
    "source": "AIDesigner Instagram Carousel prototype (2026-05-27)",
    "appliesTo": "docs/sns/instagram/_exam-packs/**",
    "consumedBy": [
      ".claude/scripts/lib/sns-common/quiz-slides.mjs",
      ".claude/skills/social/ig-post-create/scripts/ig-post-create.mjs",
      ".claude/scripts/lib/sns-common/sns-config.mjs"
    ],
    "spec": "docs/design-system/instagram-carousel.md",
    "note": "5管理別カラーテーマは廃止。管理識別は cover-title (156px) のテキストで行う。"
  },

  "canvas": {
    "width": 1080,
    "height": 1350,
    "padding": { "x": 72, "y": 80 },
    "gap": { "lg": 40, "md": 24, "sm": 16 }
  },

  "fonts": {
    "primary": {
      "family": "Manrope",
      "package": "@fontsource/manrope",
      "weights": [500, 700, 800],
      "usage": "数字・英字・装飾文字（cover-big-q / opt-num / page / brand-name 等）。Black(900) は提供されないので 800 で代替。"
    },
    "japanese": {
      "family": "NotoSansJP",
      "package": "@fontsource/noto-sans-jp",
      "weights": [500, 700, 800, 900],
      "usage": "日本語本文すべて。cover-title / q-text / opt-text / ex-text などの主役テキスト。"
    }
  },

  "colors": {
    "ink": {
      "strong": "#14191F",
      "body":   "#3F4754",
      "muted":  "#8B93A1"
    },
    "surface": {
      "page":   "#FFFFFF",
      "sunken": "#F6F8FB",
      "line":   "#E4E8EE"
    },
    "brand": {
      "active": "default",
      "presets": {
        "default": { "primary": "#1858B5", "deep": "#0E3F87", "tint": "#EDF3FB", "line": "#C9DAF0" },
        "violet":  { "primary": "#4338CA", "deep": "#312984", "tint": "#EEEDFB", "line": "#CFCAEC" },
        "teal":    { "primary": "#0F766E", "deep": "#0A5450", "tint": "#E6F3F1", "line": "#B6DAD4" },
        "warmRed": { "primary": "#D9533F", "deep": "#A93C2D", "tint": "#FBEDEA", "line": "#F0C5BD" }
      }
    },
    "semantic": {
      "correct":   { "primary": "#2C8B5F", "deep": "#1E6B47", "tint": "#E5F2EB", "line": "#B8DAC6" },
      "incorrect": { "primary": "#C8443A" }
    },
    "cta": {
      "background": "#0E2C53",
      "decor":      "#15406F",
      "accent":     "#6FB0FF"
    },
    "onDark": {
      "primary":   "#FFFFFF",
      "secondary": "rgba(255,255,255,0.7)",
      "tertiary":  "rgba(255,255,255,0.55)",
      "quaternary":"rgba(255,255,255,0.65)",
      "subtleBg":  "rgba(255,255,255,0.08)",
      "subtleLine":"rgba(255,255,255,0.15)"
    }
  },

  "typography": {
    "eyebrow":        { "fontFamily": "Manrope",    "weight": 800, "size": 24,  "letterSpacing": 0.14 },
    "page":           { "fontFamily": "Manrope",    "weight": 700, "size": 28,  "letterSpacing": 0.04 },
    "pageBold":       { "fontFamily": "Manrope",    "weight": 800, "size": 28 },
    "coverTag":       { "fontFamily": "NotoSansJP", "weight": 700, "size": 32,  "letterSpacing": 0.04 },
    "coverBigQ":      { "fontFamily": "Manrope",    "weight": 800, "size": 240, "lineHeight": 0.85, "_note": "HTML プロトでも 800（ExtraBold）。Manrope 900 は fontsource で未提供。" },
    "coverMeta":      { "fontFamily": "Manrope",    "weight": 700, "size": 38,  "letterSpacing": 0.08 },
    "coverTitle":     { "fontFamily": "NotoSansJP", "weight": 900, "size": 120, "lineHeight": 1.0,  "letterSpacing": -0.03 },
    "coverSub":       { "fontFamily": "NotoSansJP", "weight": 700, "size": 80,  "lineHeight": 1.05, "letterSpacing": 0.02 },
    "coverChip":      { "fontFamily": "NotoSansJP", "weight": 700, "size": 24 },
    "coverChipNum":   { "fontFamily": "Manrope",    "weight": 800, "size": 24 },
    "coverSwipe":     { "fontFamily": "NotoSansJP", "weight": 700, "size": 32,  "letterSpacing": 0.04 },
    "coverSwipeArrow":{ "fontFamily": "Manrope",    "weight": 800, "size": 40 },
    "qLabel":         { "fontFamily": "NotoSansJP", "weight": 700, "size": 24 },
    "qTag":           { "fontFamily": "Manrope",    "weight": 800, "size": 22,  "letterSpacing": 0.06 },
    "qText":          { "fontFamily": "NotoSansJP", "weight": 600, "size": 44,  "lineHeight": 1.45,  "letterSpacing": 0.005 },
    "qTextBold":      { "fontFamily": "NotoSansJP", "weight": 800 },
    "listItem":       { "fontFamily": "NotoSansJP", "weight": 500, "size": 24,  "lineHeight": 1.45 },
    "tableHeader":    { "fontFamily": "NotoSansJP", "weight": 800, "size": 22,  "letterSpacing": 0.04 },
    "tableCell":      { "fontFamily": "NotoSansJP", "weight": 600, "size": 24 },
    "tableCellMono":  { "fontFamily": "Manrope",    "weight": 700, "size": 24 },
    "optNum":         { "fontFamily": "Manrope",    "weight": 800, "size": 34 },
    "optText":        { "fontFamily": "NotoSansJP", "weight": 500, "size": 26,  "lineHeight": 1.5,   "letterSpacing": 0.005 },
    "optTextDense":   { "fontFamily": "NotoSansJP", "weight": 500, "size": 24,  "lineHeight": 1.5 },
    "aHeroBadge":     { "fontFamily": "Manrope",    "weight": 800, "size": 56 },
    "aHeroLabel":     { "fontFamily": "NotoSansJP", "weight": 800, "size": 20,  "letterSpacing": 0.12 },
    "aHeroTitle":     { "fontFamily": "NotoSansJP", "weight": 800, "size": 30,  "lineHeight": 1.3,   "letterSpacing": 0.005 },
    "exNum":          { "fontFamily": "Manrope",    "weight": 800, "size": 28 },
    "exMark":         { "fontFamily": "NotoSansJP", "weight": 700, "size": 28 },
    "exMarkIncorrect":{ "fontFamily": "NotoSansJP", "weight": 700, "size": 30 },
    "exText":         { "fontFamily": "NotoSansJP", "weight": 500, "size": 24,  "lineHeight": 1.5,   "letterSpacing": 0.005 },
    "exTextBold":     { "fontFamily": "NotoSansJP", "weight": 700 },
    "aPointLabel":    { "fontFamily": "NotoSansJP", "weight": 800, "size": 20,  "letterSpacing": 0.04 },
    "aPointIcon":     { "fontFamily": "Manrope",    "weight": 800, "size": 26 },
    "aPointText":     { "fontFamily": "NotoSansJP", "weight": 700, "size": 26,  "lineHeight": 1.45,  "letterSpacing": 0.005 },
    "aPointTextBold": { "fontFamily": "NotoSansJP", "weight": 800 },
    "ctaHello":       { "fontFamily": "NotoSansJP", "weight": 500, "size": 28,  "letterSpacing": 0.04 },
    "ctaHeadline":    { "fontFamily": "NotoSansJP", "weight": 900, "size": 96,  "lineHeight": 1.1,   "letterSpacing": -0.01 },
    "ctaStatNum":     { "fontFamily": "Manrope",    "weight": 800, "size": 56 },
    "ctaStatNumSm":   { "fontFamily": "Manrope",    "weight": 800, "size": 28 },
    "ctaStatLabel":   { "fontFamily": "Manrope",    "weight": 700, "size": 18,  "letterSpacing": 0.04 },
    "ctaActionTitle": { "fontFamily": "NotoSansJP", "weight": 800, "size": 32,  "letterSpacing": 0.04 },
    "ctaActionSub":   { "fontFamily": "NotoSansJP", "weight": 700, "size": 26 },
    "ctaEyebrow":     { "fontFamily": "Manrope",    "weight": 800, "size": 24,  "letterSpacing": 0.12 },
    "brandName":      { "fontFamily": "Manrope",    "weight": 800, "size": 24,  "letterSpacing": -0.01 },
    "brandUrl":       { "fontFamily": "Manrope",    "weight": 600, "size": 28, "_note": "実質的に problem 右下の「次ページで解答 →」誘導テキスト専用（cover/answer/cta は右下空白）。" }
  },

  "geometry": {
    "coverTag":   { "radius": 999, "padding": [10, 20] },
    "coverChip":  { "radius": 14,  "padding": [18, 22], "borderWidth": 1.5 },
    "qTag":       { "radius": 8,   "padding": [6, 14] },
    "opt":        { "minHeight": 96, "minHeightDense": 92, "radius": 18, "borderWidth": 2, "numColWidth": 78, "textPadding": [22, 26], "textPaddingDense": [18, 24] },
    "table":      { "radius": 12, "borderWidth": 1.5, "headerPadding": [10, 14], "cellPadding": [10, 14], "rowMinHeight": 44, "headerMinHeight": 48 },
    "lists":      { "groupGap": 16, "itemGap": 8, "padding": [12, 16], "radius": 12, "borderWidth": 1, "indent": 8 },
    "aHero":      { "radius": 20, "borderWidth": 2, "padding": [22, 28], "badgeSize": 96, "badgeRadius": 999, "gap": 24 },
    "aExplain":   { "rowGap": 12, "rowPaddingY": 12, "borderBottomWidth": 1.5, "padding": [0, 16, 0, 32], "columns": [56, 36, 0], "columnGap": 16 },
    "exNum":      { "size": 56, "radius": 14, "borderWidth": 1.5 },
    "exMark":     { "size": 36 },
    "aPoint":     { "radius": 18, "borderWidth": 3, "padding": [22, 28], "marginTop": 36, "labelOffsetY": -18, "labelOffsetX": 24, "labelPadding": [5, 16], "labelRadius": 8, "iconSize": 44, "iconRadius": 12, "gap": 18 },
    "ctaStat":    { "radius": 16, "padding": [20, 32], "borderWidth": 1.5, "gap": 32 },
    "ctaAction":  { "radius": 20, "padding": [32, 48], "minWidth": 720, "iconSize": 72, "iconRadius": 16, "gap": 24 },
    "coverSwipeChip": { "radius": 999, "padding": [14, 28], "borderWidth": 2, "gap": 16 },
    "ctaDecor":   { "topRight": { "size": 240, "offset": [-25, -8] }, "bottomLeft": { "size": 280, "offset": [-90, 28] }, "_note": "円の中心にテキスト要素全体（右上=pageBadge「10/10」、左下=brand「[●] doboku-note」のロゴ全体）が重なるよう調整。bottomLeft は約 168px の brand ロゴ全体（中心 x≈168、y≈1256）を直径 280 円の見える領域中央に配置。bottom=-90 で円の半分が画面下にはみ出し、見える領域の中央にロゴが来る。" },
    "brand":      { "dotSize": 28, "dotRadius": 8, "innerRingInset": 7, "innerRingBorder": 2.5, "centerDotInset": 11 },
    "eyebrow":    { "borderBottomWidth": 3, "padding": [8, 0], "gap": 14 }
  },

  "slides": {
    "order": ["cover", "problem", "answer", "problem", "answer", "problem", "answer", "problem", "answer", "cta"],
    "_footerNote": "cover/answer/cta の右下は空白（左下のウォーターマークと URL が重複するため撤廃）。problem だけ誘導テキスト 'next' を右下に出す。",
    "cover":   { "tagText": "総監過去問", "bigQText": "Q", "swipeText": "スワイプで4問にチャレンジ", "metaTemplate": "{year} 4問パック", "titleLine1Template": "令和{yearN}年度", "titleLine2Template": "択一式 過去問 #{packNum}", "_tagNote": "B シリーズ（_exam-packs）専用。A シリーズ（運営者作問）は別の表記を使う。", "_titleNote": "管理混在問題を回避するため、cover-title は年度ベースの統一文言。titleLine2 末尾の #N をフォント 80px で大きく表示することで、パック番号を一目で識別できる。" },
    "problem": { "eyebrowTemplate": "PROBLEM {n} / {total}", "nextText": "次ページで解答 →", "qTagText": "Q" },
    "answer":  { "eyebrowTemplate": "ANSWER {n} / {total}", "heroLabel": "正答 ／ ANSWER", "pointLabel": "ここがポイント", "pointIconChar": "!", "correctMark": "○", "incorrectMark": "X", "_markNote": "incorrect は純粋な Latin X を Manrope 800 で描画。色は付けない（○/X の形状だけで識別、解説エリアは中立色）。" },
    "cta":     {
      "eyebrowText": "FULL CONTENT",
      "helloText": "もっと解きたい人は",
      "headlineAccent": "doboku-note",
      "headlineConnector": " で",
      "headlineLine2": "全問解説をチェック",
      "stats": [{ "num": "640", "unit": "問", "label": "PRACTICE" }, { "num": "5", "unit": "管理", "label": "SCOPE" }],
      "actionTitle": "保存ボタンを押して",
      "actionSubtitle": "試験前日に見返そう"
    }
  },

  "variants": {
    "active": "refined",
    "available": ["refined", "bold", "editorial"],
    "_note": "Phase A では refined のみ実装。bold / editorial は future scope。"
  }
}
