      },
      {
        "rule": "^dairy$",
        "icon": "LiStickyNote",
        "for": "everything",
        "order": 1
      },
      {
        "rule": "^attachments$",
        "icon": "LiFileUp",
        "for": "everything",
        "order": 2
      },
      {
        "rule": "^memos$",
        "icon": "LiNotepadText",
        "for": "everything",
        "order": 3
      },
      {
        "rule": "^notes$",
        "icon": "LiNotebook",
        "for": "everything",
        "order": 4
      },
      {
        "rule": "^templates$",
        "icon": "LiBookTemplate",
        "for": "everything",
        "order": 5
      },
      {
        "rule": "^projects",
        "icon": "LiBook",
        "for": "everything",
        "order": 6
