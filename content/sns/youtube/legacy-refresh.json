    {
      "key": "multisource-evaluation",
      "source": "content/site/pe-comprehensive-management/360-degree-evaluation/article.mdx",
      "intro": "多面評価。上司だけに頼らない、人事評価の考え方です。",
      "scenes": [
        {
          "heading": "複数の視点で評価する",
          "items": [
            "上司・同僚・部下・本人",
            "行動を多角的に捉える"
          ],
          "narration": "多面評価は、上司だけでなく、同僚、部下、本人など、複数の視点から対象者を評価する手法です。"
        },
        {
          "heading": "何のために使う？",
          "items": [
            "処遇を決めるため",
            "育成・能力開発のため"
          ],
          "narration": "活用の目的には、処遇の決定と、育成、能力開発があります。導入前に、何のために評価するのかを明確にします。"
        },
        {
          "heading": "率直に答えられる設計",
          "items": [
            "評価者の匿名性を確保",
            "評価基準をそろえる"
          ],
          "narration": "率直な評価を集めるには匿名性の確保が大切です。評価者への研修で、基準の理解もそろえます。"
        }
      ]
    },
    {
      "key": "access-control",
      "source": "content/site/pe-comprehensive-management/access-control/article.mdx",
      "intro": "アクセス制御。認証と認可の違いを、三つの段階で整理します。",
      "scenes": [
        {
          "heading": "操作の範囲を決める",
          "items": [
            "情報へのアクセスを管理",
            "操作できる範囲を制限"
          ],
          "narration": "アクセス制御は、誰が、何に、どのような操作を行えるかを管理する仕組みです。"
        },
        {
          "heading": "アクセス制御の3段階",
          "items": [
            "識別：誰なのかを名乗る",
            "認証：本人かを確かめる",
            "認可：操作の範囲を決める"
          ],
          "narration": "識別は、誰なのかを名乗ること。認証は、名乗った本人かを確かめること。認可は、許可された操作の範囲を決めることです。"
        },
        {
          "heading": "権限は必要な分だけ",
          "items": [
            "業務に必要な最小限",
            "許可していない操作は拒否"
          ],
          "narration": "権限は、業務に必要な最小限だけを付与します。明示的に許可されていない操作は拒否することが基本です。"
        }
      ]
    }
  ]
