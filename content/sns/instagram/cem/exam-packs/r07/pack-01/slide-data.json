      ],
      "options": [
        {
          "num": 1,
          "text": "売上数量が800個のときの利益は416,000円である。"
        },
        {
          "num": 2,
          "text": "1個当たりの限界利益は520円である。"
        },
        {
          "num": 3,
          "text": "変動費率は60％である。"
        },
        {
          "num": 4,
          "text": "損益分岐点売上高は640,000円である。"
        },
        {
          "num": 5,
          "text": "次期に利益150,000円を獲得するために必要な売上高は1,335,000円である。"
        }
      ],
      "qNum": 2,
      "totalQ": 4
