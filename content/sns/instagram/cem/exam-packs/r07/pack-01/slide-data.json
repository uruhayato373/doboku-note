        },
        {
          "num": 2,
          "correct": false,
          "text": "1個当たり限界利益＝1,000−400＝600円。"
        },
        {
          "num": 3,
          "correct": false,
          "text": "変動費率＝400÷1,000＝40%。"
        },
        {
          "num": 4,
          "correct": true,
          "text": "損益分岐点売上高＝384,000÷0.6＝640,000円。"
        },
        {
          "num": 5,
          "correct": false,
          "text": "必要売上高＝(384,000＋150,000)÷0.6＝890,000円。"
