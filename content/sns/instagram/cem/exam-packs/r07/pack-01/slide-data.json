      ],
      "options": [
        {
          "num": 1,
          "text": "設備を更新することで加工精度を向上させ、不適合品の発生数を減らした。"
        },
        {
          "num": 2,
          "text": "事後保全活動を見直し、設備故障による修理作業の時間を短縮した。"
        },
        {
          "num": 3,
          "text": "段取作業手順の見直しで、停止時間を変えることなく作業者数を減らした。"
        },
        {
          "num": 4,
          "text": "遅くなっていた設備のスピードを上げて、稼働時間内の加工数量を増やした。"
        },
        {
          "num": 5,
          "text": "設備本体の清掃を徹底し、チョコ停の発生回数を減らした。"
        }
      ],
      "qNum": 3,
      "totalQ": 4
