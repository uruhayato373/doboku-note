content/sns/instagram/**/reels/wav/
content/sns/instagram/**/reels/slide-*.mp4
content/sns/instagram/**/reels/_combined.mp4
content/sns/instagram/**/reels/_empty.ass
content/sns/instagram/**/reels/concat.txt

# doc-meta-index.json は全 MDX frontmatter から build-doc-meta-index.mjs が再生成する成果物。
# 過去7日で70回commit・97.7MB の履歴肥大の主因だった（1.42MB×70版）。predev / CI 側の
# 明示ステップで再生成する（真実源: .claude/scripts/build-doc-meta-index.mjs）。2026-08-29。
src/config/doc-meta-index.json

# quality:audit の生成レポート（baseline はコミットする・reportは生成物）
.claude/state/quality/audit-latest.json
.claude/state/quality/audit-latest.md
.claude/state/quality/env-inventory.json
.claude/state/quality/image-audit.json
.claude/state/quality/image-audit.md

# magazine-to-pdf の一時Chromeプロファイル/HTML作業ディレクトリ
**/pdf/_work/

# Playwright の実行成果物（失敗時のスクショ・trace）。SoT ではないので追跡しない
/test-results/
/playwright-report/

# リポジトリ資産監査（DN-0111）の run 出力。baseline.json（固定値）と audit-latest.md（可読レポート）は
# 追跡し、audit-latest.json は baseline と同内容の再生成物なので追跡しない。
.claude/state/repo-assets/audit-latest.json

# note カバーの SVG は satori の中間生成物。V4 は背景写真を data:image base64 で丸ごと内包するため
# 1 枚 1.5〜2.6 MiB になり、827 件 1,288.6 MiB（HEAD の 31%）を追跡していた。読むコードは 1 行も無く
# （note-publish / note-update-cover / note-cover-gallery / note-lint / check-note-cover-fit /
# check-note-3set の 3点セットゲートは全て cover*.png のみを見る）、R2 にも同期されていない。
# 描画デバッグで要るときは generate-note-covers.mjs --emit-svg で .tmp/note-covers/ へ出す。
# 図版の figure-*.svg は本文が参照する原本なので巻き込まないこと（2026-08-21・DN-0111 Phase 2）。
content/note/**/img/cover*.svg

# アセット hydrate の cache（DN-0111 Phase 3）。R2 から取ったものの置き場で、消しても
# R2 から取り直せる。プロキシ不調時はここだけが頼りになるので **勝手に空にしないこと**
# （asset-hydrate は上限超過時に最終アクセスの古いものだけを落とす）。
.local/cache/

# build-pe1-kindle.mjs 用のR2公開画像ミラー（content/site/**/imgをGitの内容と一致させて
# ローカルに複製したもの＝配信コピーの再配信コピー。Kindleビルド時のみ使う使い捨てキャッシュで、
# 台帳不要（Gitの実体から再生成できる）。
.local/r2/

# 教材（スキャン原本）のページ画像・PDF は実体を Google Drive vault（drive-vault.json の
# textbook-page-image / textbook-source-pdf group・台帳 drive-manifest.json）に置く。
# 追跡していたのは 868 件 571.2 MiB で、Git に置く理由が無い——原本は書籍、
# 文字起こし .md と真正ベクター .svg が SSOT で、ラスタは OCR / crop の中間物。
# 取り戻すのは書名単位で
# `npm run drive-vault-sync -- --pull --path 'content/sources/textbook/{書名}/'`。
# .md と .svg は意図的に除外していない（Git に残すのが正）。
# 2026-08-21・DN-0111 Phase 4-C。2026-09-05 に private R2 から Drive vault へ移設。
content/sources/textbook/**/*.png
content/sources/textbook/**/*.jpg
content/sources/textbook/**/*.jpeg
content/sources/textbook/**/*.webp
content/sources/textbook/**/*.pdf

# note カバー PNG は private R2（doboku-note-archive/note/covers/）が保管先（2026-09-05 DN-0171 まで公開済みは public にも複製）。
# 追跡していたのは 827 件 725.5 MiB。frontmatter の cover: ブロックが原本で、PNG は
# そこからの生成物だが **byte 再現はできない**（実測で 827 件中 9 件が不一致・
# sharp は package.json が ^0.35.0 なので他マシンでの一致も保証されない）。
# そのため再生成任せにせず R2 に保管する。取り戻すのは
#   npm run asset-hydrate -- --group note-cover-png
# 新規カバーを作ったら退避すること。未退避は check-asset-storage が検出する。
# 2026-08-21・DN-0111 Phase 4-B。
content/note/**/img/cover*.png

# 著者オーソリティ バナーの記事ごとの複製（197 本×約 220KB）。原本は
# content/note/共通/著者オーソリティ/img/figure-author-authority*.png（追跡）で、各記事の img/ には
# scripts/distribute-author-authority-banner.mjs が複製するだけの成果物。再生成は
#   node scripts/distribute-author-authority-banner.mjs --migrate（civil）／--exam concrete --all
# 2026-09-05・正方形再設計で 197 本が一斉に差分になったのを機に cover*.png と同じ扱いへ。
content/note/**/img/figure-author-authority*.png
!content/note/共通/著者オーソリティ/img/figure-author-authority*.png

# note の配布 PDF は実体を Google Drive vault（drive-vault.json の note-delivery-pdf group・
# 台帳 drive-manifest.json）に置く。購入者限定の配布物を含む。
# 追跡していたのは 586 件 273.0 MiB。生成 spec と商品 ID が原本で、PDF はそこからの成果物。
# note へ添付するときは note-attach-file が自動で取り寄せる（取れなければ note へ書かずに止まる）。
# 手で取り戻すのは `npm run drive-vault-sync -- --pull --path 'content/note/{該当パス}/'`。
# 2026-08-21・DN-0111 Phase 4-D。2026-09-05 に private R2 から Drive vault へ移設。
content/note/**/*.pdf

# Instagram のレンダー画像は実体を Google Drive vault（drive-vault.json の ig-rendered-image group・
# 台帳 drive-manifest.json）に置く（投稿済み・未投稿とも）。
# 追跡していたのは 1,990 件 234.4 MiB。SoT は slide-data.json と同名 .svg（どちらも Git に残す）。
# reels/ 配下の wav/mp4 は sns-archived-media（Drive vault・sns-archive-policy）で既に ignore 済み。
# publish-ig-bs は投稿前に自動で取り寄せ、取れなければ Instagram へ触れずに止まる。
# 2026-08-21・DN-0111 Phase 4-E。2026-09-05 に private R2 から Drive vault へ移設。
content/sns/instagram/**/*.png
content/sns/instagram/**/*.jpg
content/sns/instagram/**/*.jpeg

# 教材の原典 PDF は実体を Google Drive vault（drive-vault.json の textbook-source-pdf group・
# 台帳 drive-manifest.json）に置く。2026-07 に R2 へ出し、2026-08-22 に git 履歴からも除去した
# （389 件）。2026-09-05 に置き場ルールを「誰が使うか」へ改め、private R2 から Drive vault へ移設した。
# `npm run drive-vault-sync -- --pull --path 'content/sources/textbook/{書名}/'` で docs/textbook/ 配下へ取り戻すが、
# **取り戻したものを再びコミットしないこと**（実測でここが素通りだったので明示的に塞ぐ）。
docs/textbook/

# ogp.webp は og:image が参照しない未使用の派生ファイル（読むコード0行）。
# ogp.png から prebuild のたび generate-webp.mjs が再生成する純中間物で、
# 過去7日で履歴肥大の一因だった。generate-webp.mjs は img/ 配下限定に修正済みで
# 新規には作られなくなるが、既存の追跡分は untrack する（実体はローカルに残す）。
# 2026-08-29。
content/site/**/ogp.webp

# ogp.png（1,166件・607MB＝git追跡容量の52%）は asset-storage.json の site-ogp-png
# group でR2退避済み（--verify 3者照合OK）。配信は既にR2 301（public/_redirects）
# 経由で本番稼働中なので untrack しても配信影響なし。新規記事はdevelopへpushすれば
# ogp-supply.ymlが自動生成してR2へ供給する（即時反映したい場合のみ手動で
# node scripts/asset-offload.mjs --group site-ogp-png --commit）。
# 復元は node scripts/asset-hydrate.mjs --group site-ogp-png。2026-08-29・DN-0111系。
content/site/**/ogp.png

# content/note/**/magazines/*/_cover.png（46件・45.1MB）は実体を Google Drive vault
# （drive-vault.json の note-magazine-cover-png group・台帳 drive-manifest.json）に置く。
# マガジンにはarticle.mdが無く既存note-cover-pngのfrontmatter判定が使えないため
# 別グループとして分離。復元は node scripts/drive-vault-sync.mjs --pull --path 'content/note/{該当パス}/'。
# 2026-08-29。2026-09-05 に private R2 から Drive vault へ移設。
content/note/**/magazines/*/_cover.png

# .claude/config/coconala/assets/（59件・28.3MB）は実体を Google Drive vault
# （drive-vault.json の coconala-asset group・台帳 drive-manifest.json）に置く。
# ココナラ出品Playwright自動化はローカル実体を直接参照するので挙動不変。
# 復元は node scripts/drive-vault-sync.mjs --pull --path '.claude/config/coconala/assets/'。
# 2026-08-29。2026-09-05 に private R2 から Drive vault へ移設。
.claude/config/coconala/assets/**

# repo-archive group（性質の異なる3種の死蔵物・13件・27.0MB）は実体を Google Drive vault
# （drive-vault.json の repo-archive group・台帳 drive-manifest.json）に置く: OCR監査ログ・
# Kindle表紙デザイン案・キャラ素材グリッド原本。監査証跡として当面残す価値があるため消さず退避。
# 読む人はいても読むコードは無い（audience=human）。
# 復元は node scripts/drive-vault-sync.mjs --pull --path '{対象パス}'。
# 2026-08-29。2026-09-05 に private R2 から Drive vault へ移設。
.claude/state/ocr-audit/**
