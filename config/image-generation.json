  "antiAi": {
    "version": 1,
    "avoid": "光沢の強い質感、レンズフレア、意味のない光の筋、不自然な左右対称、絵空事の未来的な機材、読めない看板や記号、同じ形の雲の繰り返し、彩度の高すぎる青空、白く飛んだ空、崩れた手指は描かない。",
    "real": "日本の土木現場の実物に寄せる。機材は実在する形と部品の配置で描き、保護具、仮囲い、地面の土や砕石の質感を具体的に描く。整いすぎた理想図ではなく、実際の現場の少し雑然とした配置にする。",
    "tone": "色数を抑えた落ち着いた教材イラスト。太さの揃った輪郭線とマットな塗り。ライトとダークのどちらの背景でも浮かないよう、画面全体を中間から濃い色調でまとめ、白い大きな面を作らない。"
  },
  "formats": {
    "longform": {
      "width": 1920,
      "height": 1080,
      "bottomZone": 0.18,
      "frame": "すべての意味ある文字・図は左右5%・上5%・下18%の内側に置く。下端は字幕用の無地の背景だけ。"
    },
    "shorts": {
      "width": 1080,
      "height": 1920,
      "minWidth": 900,
      "bottomZone": 0.18,
      "frame": "縦9:16（1080×1920想定）で構図し直す。横長の参照を引き伸ばしたり切り取ったりしない。背景は上下左右の四辺まで連続させ、無地の帯や大きな空白を作らない。背景は1枚の連続した絵として描き、縦の境界線で途切れさせない。重要な文字・図・顔は左右とも6%以上内側、上は8%より下、下は端から32%より上に収める。画面の上から45%より下では、右端から18%の範囲（アプリの操作ボタンが載る）にも重要な文字・顔を置かない（下32%は字幕とボタンが載る。背景の模様だけは続ける）。",
      "bodyFrame": "ラベル・番号・見出し・図のすべてを、画面の左から8%〜80%、上から8%〜64%の長方形の中に収める。図はその長方形の下側を使って大きく描く。長方形の外（左端の8%、右端の20%、下の36%）には文字も図の部品も置かず、背景の模様だけを続ける。"
    },
    "kindle": {
      "width": 1600,
      "height": 2560,
      "minWidth": 960,
      "bottomZone": 0,
      "frame": "媒体: Kindle電子書籍の表紙。縦長 5:8（1600×2560相当）。Amazonの検索結果の小さなサムネイル（幅約136px）でも題名・丸い印・帯の文字が読める構成にする。背景は四辺まで連続させ、無地の余白帯を作らない。人物の身体と文字を画面の端で切らない。"
    }
  },
