{
  "version": 1,
  "description": "SEO meta 監査の対象 URL（include_routes）と HTTP 巡回互換設定。canonical/og:url/title/SSR の実判定ロジックは scripts/lib/seo-checks.mjs が真実源（主経路は out/ 直接検査・dev server 不要）。base_url/thresholds は --base-url の HTTP 巡回モード互換用（重大度はコード側＝seo-checks.mjs の level が持つ）。Issue #125。",
  "base_url": "http://localhost:3020",
  "production_url": "https://doboku-note.com",
  "url_source": "src/config/doc-meta-index.json",
  "include_routes": [
    "/",
    "/about",
    "/contact",
    "/exam",
    "/exam/civil-construction-1",
    "/exam/pe-comprehensive-management",
    "/practice",
    "/privacy",
    "/standards",
    "/terms",
    "/topics",
    "/search"
  ],
  "concurrency": 8,
  "timeout_ms": 10000,
  "thresholds": {
    "title": {
      "max_length": 70,
      "site_name_max_count": 1,
      "site_name": "doboku-note"
    },
    "description": {
      "min_length": 50,
      "max_length": 160
    },
    "canonical": {
      "required": true,
      "must_start_with": "https://doboku-note.com"
    },
    "og": {
      "required_keys": ["title", "description", "image", "url", "type"]
    },
    "twitter": {
      "required_keys": ["card"]
    },
    "json_ld": {
      "min_count": 1,
      "required_types_any_of": [["BreadcrumbList", "WebSite"]],
      "faq_validation": {
        "min_main_entity": 1,
        "min_question_chars": 5,
        "min_answer_chars": 10
      }
    }
  }
}
