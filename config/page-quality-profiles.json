    {
      "id": "practice-guide",
      "label": "土木施工の実務解説",
      "match": { "area": "practice", "groups": ["guide"] },
      "focus": "現場の判断に使えるか、数値・規格値が一次資料（基準書・法令）で裏付けられ出典が示されているか",
      "machineChecks": ["validate-mdx", "guide-length", "egov-links", "external-links"],
      "metrics": ["chars", "h2", "images", "tables", "internalLinks"],
      "evaluators": [
        { "agent": "guide-qa", "role": "rubric" },
        { "agent": "guide-fact-checker", "role": "facts" },
        { "agent": "svg-figure-auditor", "role": "figures" }
      ],
      "notApplicable": [
        "note・試験向けの CTA を求めない（実務の読者に試験の導線は合わない）",
        "ExamPoint・Callout「試験のポイント」を求めない",
        "「## 参考資料」を禁じない（一次資料の明示を求める側）"
      ]
    },
    {
      "id": "laws-guide",
      "label": "法令の解説",
      "match": { "area": "laws", "groups": ["guide"] },
      "focus": "条文の要点が正確か、e-Gov の条へリンクし、その法令を扱う試験・実務の記事へつながっているか",
      "machineChecks": ["validate-mdx", "egov-links"],
      "metrics": ["chars", "h2", "internalLinks"],
      "evaluators": [
        { "agent": "guide-qa", "role": "rubric" },
        { "agent": "guide-fact-checker", "role": "facts" }
      ],
      "notApplicable": [
        "note・試験向けの CTA を求めない（実務の読者に試験の導線は合わない）",
        "ExamPoint・Callout「試験のポイント」を求めない",
        "「## 参考資料」を禁じない（一次資料の明示を求める側）"
      ]
    },
    {
      "id": "standards-chapter",
      "label": "基準書の章記事",
      "match": { "paths": ["content/site/standards-articles"], "file": "^\\d+(-\\d+)*\\.md$" },
      "focus": "原本と同じか（文字の過不足 0）、表が Markdown の表に組み直され、図が原本から切り出されているか",
      "machineChecks": ["standard-articles", "standards-page-images", "standards-amendments"],
      "metrics": ["chars", "tables", "images", "tableCaptions", "figureCaptions"],
      "evaluators": [
        { "agent": "standards-table-qa", "role": "tables" },
        { "agent": "scanned-figure-crop-auditor", "role": "figures" }
      ],
      "notApplicable": [
        "字数・見出しの数・導線を求めない（原本の逐語）"
      ]
    },
    {
      "id": "standards-library",
      "label": "基準書の全文ライブラリ",
      "match": { "paths": ["content/site/standards-library"], "file": "^part-\\d+\\.md$" },
      "focus": "原本と同じか（文字化け 0）に加えて、表と図がどこまで展開されているか（PDF から抜いたままのテキストを減らす）",
      "machineChecks": ["standards-library"],
      "metrics": ["chars", "tables", "images", "tableCaptions", "figureCaptions", "rawTextBlocks"],
      "evaluators": [],
      "notApplicable": [
        "字数・見出しの数・導線を求めない（原本の逐語）"
      ]
    }
  ]
}
