  "automations": [
    {
      "id": "weekly-review",
      "runner": "mac-launchd",
      "source": "scripts/scheduled/com.doboku-note.weekly-review.plist.tmpl",
      "title": "土曜の収集と週次レビュー",
      "triggers": [
        "launchd"
      ],
      "schedule": [
        "土 09:30"
      ],
      "scheduleJst": "毎週土曜 09:30（寝ていた日は起床時）",
      "login": [
        "a8",
        "kdp",
        "note",
        "coconala",
        "google"
      ],
      "purpose": "ログインが要る取得と書き込みを 1 本ずつ回し（weekly-collect の前後・取った記録の検算つき）、note の公開状態の照合（公開 API）・公開画面の撮影と競合の公開データ（四半期の最初の土曜だけ）も前段で回す。続けてヘッドレスの Claude Code で GSC の記録層（週次観測・coverage・改善候補。旧 gsc-auto-review.yml）を書いて develop へ push する。週次・月次レビューは回さず、運営者の指示で対話セッションが実行する（2026-11-08〜・DN-0817・DN-0847・DN-0849・DN-0852）",
      "readers": [
        "quality-audit:weekly-collect",
        "issue:weekly-collect",
        "issue:gsc-auto-review",
        "admin:/metrics/business",
        "admin:/content/note",
        "admin:/ops/mac",
        "quality-audit:competitor-scan-due",
        "admin:/strategy/competitors",
        "skill:weekly-review"
      ],
      "writes": [
        "state.weekly-collect",
        "note.sales",
        "coconala.analytics",
        "a8.ui-last-run",
        "note.sync-log",
        "note.status",
        "note.magazines",
        "state.improvements",
        "business.measurement"
      ]
    },
    {
      "id": "disk-hygiene",
      "runner": "mac-launchd",
      "source": "scripts/scheduled/com.doboku-note.disk-hygiene.plist.tmpl",
      "title": "ディスクの掃除",
      "triggers": [
        "launchd"
      ],
      "schedule": [
        "毎日 04:17"
      ],
      "scheduleJst": "毎日 04:17",
      "login": [],
